<?xml version="1.0" encoding="UTF-8"?>
<!-- Plantilla launchd: ejecuta la actualización cada día a las 06:15.
     Instalar:   cp scripts/com.pokeprice.daily.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.pokeprice.daily.plist
     Desinstalar: launchctl unload ~/Library/LaunchAgents/com.pokeprice.daily.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.pokeprice.daily</string>
  <key>ProgramArguments</key>
  <array><string>/Volumes/dureza/pokeprice/scripts/daily-local.sh</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>15</integer></dict>
  <key>StandardErrorPath</key><string>/tmp/pokeprice-daily.err</string>
</dict>
</plist>
